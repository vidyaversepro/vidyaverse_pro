# Application
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database (MySQL)
DATABASE_URL=mysql://root:vidyaverse123@localhost:3306/vidyaverse
DB_CONNECTION_LIMIT=100

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRY=7d

# Better Auth
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_SECRET=your-better-auth-secret-must-be-at-least-32-characters-long

# Cloudflare R2 (Object Storage)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=vidyaverse
R2_PUBLIC_URL=https://storage.yourdomain.com
R2_REGION=auto

# Google Gemini AI (for photo enhancement fallback)
GEMINI_API_KEY=
ENABLE_AI_ENHANCEMENT=true
OPENCV_THRESHOLD=0.5

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Vidyaverse Pro <noreply@vidyaverse.app>

# File Upload
MAX_UPLOAD_SIZE_MB=10

# System Configuration
DEFAULT_TRIAL_DAYS=7
MAINTENANCE_MODE=false
ENABLE_REGISTRATION=true
