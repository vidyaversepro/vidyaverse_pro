# Root build context (Coolify builds both backend and frontend from here).
# Dependencies + build output are regenerated inside the image.
node_modules
**/node_modules
dist
**/dist
build
**/build

# Secrets / local env (Coolify injects env at runtime)
.env
.env.*
!.env.example
backend/.env

# VCS, logs, scratch
.git
.gitignore
*.log
build-output.txt
*.tsbuildinfo

# Docker / compose (not needed inside an image build)
docker-compose*.yml
**/Dockerfile
!backend/Dockerfile
!frontend/Dockerfile

# Tests / docs / editor cruft
**/coverage
.vscode
.idea
.DS_Store
Thumbs.db
