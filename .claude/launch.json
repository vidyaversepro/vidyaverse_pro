{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vidyaverse-backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev:backend"
      ],
      "port": 3002
    },
    {
      "name": "vidyaverse-frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev:frontend"
      ],
      "port": 5173
    },
    {
      "name": "vidyaverse-prod-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
