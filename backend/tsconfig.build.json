{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "strict": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noImplicitReturns": false,
        "noFallthroughCasesInSwitch": false,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "prisma/seed.ts",
        "tests",
        "**/*.test.ts",
        "**/*.spec.ts"
    ]
}