generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Institution {
  id                             String                          @id @default(uuid()) @db.Char(36)
  name                           String                          @db.VarChar(255)
  code                           String                          @unique @db.VarChar(50)
  institutionType                InstitutionType                 @default(SCHOOL) @map("institution_type")
  address                        String?                         @db.Text
  contactEmail                   String?                         @map("contact_email") @db.VarChar(255)
  contactPhone                   String?                         @map("contact_phone") @db.VarChar(20)
  academicYear                   String                          @default("2025-2026") @map("academic_year") @db.VarChar(20)
  logoUrl                        String?                         @map("logo_url") @db.VarChar(500)
  darkLogoUrl                    String?                         @map("dark_logo_url") @db.VarChar(500)
  signatureUrl                   String?                         @map("signature_url") @db.VarChar(500)
  signatureTitle                 String                          @default("Principal") @map("signature_title") @db.VarChar(100)
  sealUrl                        String?                         @map("seal_url") @db.VarChar(500)
  enabledFields                  Json                            @map("enabled_fields")
  customFields                   Json                            @map("custom_fields")
  enabledServices                Json                            @map("enabled_services")
  subscriptionTier               SubscriptionTier                @default(starter) @map("subscription_tier")
  subscriptionStatus             SubscriptionStatus              @default(trial) @map("subscription_status")
  trialEndsAt                    DateTime?                       @map("trial_ends_at")
  subscriptionStart              DateTime?                       @map("subscription_start")
  subscriptionEnd                DateTime?                       @map("subscription_end")
  monthlyAiUsage                 Int                             @default(0) @map("monthly_ai_usage")
  monthlyPdfPages                Int                             @default(0) @map("monthly_pdf_pages")
  monthlyEmailSent               Int                             @default(0) @map("monthly_email_sent")
  storageUsedMb                  Decimal                         @default(0.00) @map("storage_used_mb") @db.Decimal(10, 2)
  isActive                       Boolean                         @default(true) @map("is_active")
  onboardingCompleted            Boolean                         @default(false) @map("onboarding_completed")
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  adminInvitations               AdminInvitation[]
  approvalRequests               ApprovalRequest[]
  approvalWorkflows              ApprovalWorkflow[]
  approvals                      Approval[]
  attendanceLogs                 AttendanceLog[]
  attendanceSessions             AttendanceSession[]
  auditLogs                      AuditLog[]
  branches                       Branch[]
  calculationEngines             CalculationEngine[]
  certificates                   Certificate[]
  classes                        Class[]
  examSchedules                  ExamSchedule[]
  groupPhotos                    GroupPhoto[]
  hallTickets                    HallTicket[]
  idCardBatches                  IdCardBatch[]
  idCards                        IdCard[]
  authorities                    InstitutionAuthority[]
  jobExecutions                  JobExecution[]
  libraryCards                   LibraryCard[]
  marksheets                     Marksheet[]
  notificationLogs               NotificationLog[]
  notificationTemplates          NotificationTemplate[]
  notifications                  Notification[]
  portfolios                     Portfolio[]
  sections                       Section[]
  socialPosts                    SocialPost[]
  socialRelationships            SocialRelationship[]
  streams                        Stream[]
  StudentFormProgress            StudentFormProgress[]
  StudentOnboardingToken         StudentOnboardingToken[]
  students                       Student[]
  subjects                       Subject[]
  templates                      Template[]
  transferCertificates           TransferCertificate[]
  userRoles                      UserInstitutionRole[]
  visionariumArticles            VisionariumArticle[]
  visionariumSchoolSubscriptions VisionariumSchoolSubscription[]
  visionariumSubmissions         VisionariumSubmission[]
  visionariumTestSeries          VisionariumTestSeries[]
  visitingCards                  VisitingCard[]

  @@index([code])
  @@index([subscriptionStatus, subscriptionTier])
  @@index([isActive])
  @@map("institutions")
}

model InstitutionAuthority {
  id            String                   @id @default(uuid()) @db.Char(36)
  institutionId String                   @map("institution_id") @db.Char(36)
  name          String                   @db.VarChar(255)
  designation   String                   @db.VarChar(255)
  roleType      InstitutionAuthorityRole @default(CUSTOM) @map("role_type")
  email         String?                  @db.VarChar(255)
  phone         String?                  @db.VarChar(20)
  signatureUrl  String?                  @map("signature_url") @db.VarChar(500)
  displayOrder  Int                      @default(0) @map("display_order")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  institution   Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([roleType])
  @@map("institution_authorities")
}

model Branch {
  id            String      @id @default(uuid()) @db.Char(36)
  institutionId String      @map("institution_id") @db.Char(36)
  name          String      @db.VarChar(255)
  code          String      @db.VarChar(50)
  address       String?     @db.Text
  contactEmail  String?     @map("contact_email") @db.VarChar(255)
  contactPhone  String?     @map("contact_phone") @db.VarChar(20)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classes       Class[]
  students      Student[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("branches")
}

model User {
  id                        String                  @id @default(uuid()) @db.Char(36)
  email                     String                  @unique @db.VarChar(255)
  passwordHash              String?                 @map("password_hash") @db.VarChar(255)
  name                      String                  @db.VarChar(255)
  phone                     String?                 @db.VarChar(20)
  emailVerified             Boolean                 @default(false) @map("email_verified")
  image                     String?                 @db.Text
  isActive                  Boolean                 @default(true) @map("is_active")
  isVerified                Boolean                 @default(false) @map("is_verified")
  emailVerificationToken    String?                 @map("email_verification_token") @db.VarChar(255)
  passwordResetToken        String?                 @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires      DateTime?               @map("password_reset_expires")
  twoFactorEnabled          Boolean                 @default(false) @map("two_factor_enabled")
  twoFactorSecret           String?                 @map("two_factor_secret") @db.VarChar(255)
  globalRole                GlobalRole?             @default(student) @map("global_role")
  lastLoginAt               DateTime?               @map("last_login_at")
  lastLoginIp               String?                 @map("last_login_ip") @db.VarChar(50)
  failedLoginAttempts       Int                     @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime?               @map("locked_until")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  accounts                  Account[]
  approvalRequests          ApprovalRequest[]
  approvedSteps             ApprovalStep[]
  reviewedApprovals         Approval[]              @relation("ReviewedApprovals")
  submittedApprovals        Approval[]              @relation("SubmittedApprovals")
  markedAttendanceRecords   AttendanceRecord[]
  createdAttendanceSessions AttendanceSession[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  classTeacherSections      Section[]               @relation("SectionClassTeacher")
  sessions                  Session[]
  socialComments            SocialComment[]         @relation("UserComments")
  socialPosts               SocialPost[]            @relation("UserPosts")
  socialReactions           SocialReaction[]        @relation("UserReactions")
  relationshipsFrom         SocialRelationship[]    @relation("RelationshipsFrom")
  relationshipsTo           SocialRelationship[]    @relation("RelationshipsTo")
  saathiSent                SocialSaathiLink[]      @relation("SaathiSent")
  saathiReceived            SocialSaathiLink[]      @relation("SaathiReceived")
  institutionRoles          UserInstitutionRole[]
  authoredArticles          VisionariumArticle[]    @relation("UserArticles")
  visionariumSubmissions    VisionariumSubmission[] @relation("UserSubmissions")
  visitingCards             VisitingCard[]

  @@index([email])
  @@index([passwordResetToken])
  @@map("users")
}

model AdminInvitation {
  id            String           @id @default(uuid()) @db.Char(36)
  institutionId String           @map("institution_id") @db.Char(36)
  email         String           @db.VarChar(255)
  token         String           @unique @db.VarChar(255)
  expiresAt     DateTime         @map("expires_at")
  status        InvitationStatus @default(pending)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([institutionId])
  @@map("admin_invitations")
}

model UserInstitutionRole {
  id                   String          @id @default(uuid()) @db.Char(36)
  userId               String          @map("user_id") @db.Char(36)
  institutionId        String          @map("institution_id") @db.Char(36)
  role                 InstitutionRole
  assignedClasses      Json?           @map("assigned_classes")
  assignedSections     Json?           @map("assigned_sections")
  studentAccessEnabled Boolean         @default(false) @map("student_access_enabled")
  studentAccessExpires DateTime?       @map("student_access_expires")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  institution          Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
  @@index([role])
  @@index([institutionId])
  @@map("user_institution_roles")
}

model Class {
  id                    String                  @id @default(uuid()) @db.Char(36)
  institutionId         String                  @map("institution_id") @db.Char(36)
  branchId              String?                 @map("branch_id") @db.Char(36)
  name                  String                  @db.VarChar(100)
  displayOrder          Int                     @default(0) @map("display_order")
  streamsEnabled        Boolean                 @default(false) @map("streams_enabled")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  attendanceSessions    AttendanceSession[]
  branch                Branch?                 @relation(fields: [branchId], references: [id])
  institution           Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  groupPhotos           GroupPhoto[]
  sections              Section[]
  socialPosts           SocialPost[]
  streams               Stream[]
  subjects              Subject[]
  visionariumTestSeries VisionariumTestSeries[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([branchId])
  @@map("classes")
}

model Stream {
  id            String      @id @default(uuid()) @db.Char(36)
  institutionId String      @map("institution_id") @db.Char(36)
  classId       String      @map("class_id") @db.Char(36)
  name          String      @db.VarChar(100)
  description   String?     @db.Text
  displayOrder  Int         @default(0) @map("display_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  sections      Section[]
  class         Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
  @@index([institutionId], map: "streams_institution_id_fkey")
  @@map("streams")
}

model Section {
  id                   String              @id @default(uuid()) @db.Char(36)
  institutionId        String              @map("institution_id") @db.Char(36)
  classId              String              @map("class_id") @db.Char(36)
  streamId             String?             @map("stream_id") @db.Char(36)
  name                 String              @db.VarChar(50)
  expectedStudentCount Int                 @default(0) @map("expected_student_count")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  classTeacherId       String?             @map("class_teacher_id") @db.Char(36)
  admissionSlots       AdmissionSlot[]
  attendanceSessions   AttendanceSession[]
  groupPhotos          GroupPhoto[]
  class                Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher         User?               @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])
  institution          Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  stream               Stream?             @relation(fields: [streamId], references: [id])
  socialPosts          SocialPost[]
  students             Student[]

  @@unique([classId, streamId, name])
  @@index([classTeacherId], map: "sections_class_teacher_id_fkey")
  @@index([institutionId], map: "sections_institution_id_fkey")
  @@index([streamId], map: "sections_stream_id_fkey")
  @@map("sections")
}

model AdmissionSlot {
  id             String     @id @default(cuid()) @db.Char(30)
  sectionId      String     @map("section_id") @db.Char(36)
  rollNo         Int        @map("roll_no")
  status         SlotStatus @default(EMPTY)
  token          String     @unique @default(cuid()) @db.VarChar(50)
  tokenExpiresAt DateTime?  @map("token_expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  section        Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student        Student?

  @@unique([sectionId, rollNo])
  @@index([sectionId])
  @@index([status])
  @@index([token])
  @@map("admission_slots")
}

model Student {
  id                      String                   @id @default(uuid()) @db.Char(36)
  institutionId           String                   @map("institution_id") @db.Char(36)
  sectionId               String                   @map("section_id") @db.Char(36)
  branchId                String?                  @map("branch_id") @db.Char(36)
  slotId                  String?                  @unique @map("slot_id") @db.Char(30)
  admissionNumber         String?                  @unique @map("admission_number") @db.VarChar(50)
  name                    String                   @db.VarChar(255)
  academicYear            String                   @default("2025-2026") @map("academic_year") @db.VarChar(20)
  fatherName              String?                  @map("father_name") @db.VarChar(255)
  motherName              String?                  @map("mother_name") @db.VarChar(255)
  guardianName            String?                  @map("guardian_name") @db.VarChar(255)
  guardianRelation        String?                  @map("guardian_relation") @db.VarChar(50)
  guardianPhone           String?                  @map("guardian_phone") @db.VarChar(20)
  sex                     Sex?
  dob                     DateTime?                @db.Date
  bloodGroup              String?                  @map("blood_group") @db.VarChar(10)
  aadharNumber            String?                  @map("aadhar_number") @db.VarChar(12)
  caste                   String?                  @db.VarChar(100)
  religion                String?                  @db.VarChar(100)
  contact                 String?                  @db.VarChar(20)
  parentEmail             String?                  @map("parent_email") @db.VarChar(255)
  address                 String?                  @db.Text
  city                    String?                  @db.VarChar(100)
  state                   String?                  @db.VarChar(100)
  pincode                 String?                  @db.VarChar(10)
  dateOfAdmission         DateTime?                @map("date_of_admission") @db.Date
  previousSchool          String?                  @map("previous_school") @db.Text
  transportMode           String?                  @map("transport_mode") @db.VarChar(50)
  photoUrl                String?                  @map("photo_url") @db.VarChar(500)
  photoHash               String?                  @map("photo_hash") @db.VarChar(64)
  studentSignatureUrl     String?                  @map("student_signature_url") @db.VarChar(500)
  parentSignatureUrl      String?                  @map("parent_signature_url") @db.VarChar(500)
  medicalNotes            String?                  @map("medical_notes") @db.Text
  status                  StudentStatus            @default(active)
  dataStatus              DataStatus               @default(filled) @map("data_status")
  consentGiven            Boolean                  @default(false) @map("consent_given")
  consentTimestamp        DateTime?                @map("consent_timestamp")
  consentGivenBy          String?                  @map("consent_given_by") @db.VarChar(255)
  customData              Json                     @map("custom_data")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  photoMetadata           Json?                    @map("photo_metadata")
  photoUpdatedAt          DateTime?                @map("photo_updated_at")
  photoVersion            Int                      @default(0) @map("photo_version")
  thumbUrl                String?                  @map("thumb_url") @db.VarChar(500)
  attendanceLogs          AttendanceLog[]
  attendanceRecords       AttendanceRecord[]
  certificates            Certificate[]
  groupPhotoExtractions   GroupPhotoExtraction[]
  hallTickets             HallTicket[]
  idCards                 IdCard[]
  libraryCards            LibraryCard[]
  marks                   Mark[]
  marksheets              Marksheet[]
  portfolio               Portfolio?
  socialPosts             SocialPost[]             @relation("StudentPosts")
  formProgress            StudentFormProgress?
  onboardingToken         StudentOnboardingToken?
  branch                  Branch?                  @relation(fields: [branchId], references: [id])
  institution             Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  section                 Section                  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  admissionSlot           AdmissionSlot?           @relation(fields: [slotId], references: [id])
  transferCertificates    TransferCertificate[]
  authoredArticles        VisionariumArticle[]     @relation("StudentArticles")
  visionariumSubmissions  VisionariumSubmission[]  @relation("StudentSubmissions")
  visionariumTestAttempts VisionariumTestAttempt[] @relation("StudentTestAttempts")
  visitingCards           VisitingCard[]

  @@index([institutionId])
  @@index([branchId])
  @@index([sectionId])
  @@index([slotId])
  @@index([status])
  @@index([dataStatus])
  @@index([photoHash])
  @@index([institutionId, status])
  @@index([institutionId, dataStatus])
  @@fulltext([name, fatherName, motherName, admissionNumber])
  @@map("students")
}

model Template {
  id                   String                @id @default(uuid()) @db.Char(36)
  institutionId        String                @map("institution_id") @db.Char(36)
  name                 String                @db.VarChar(255)
  serviceType          ServiceType           @map("service_type")
  templateType         TemplateType          @default(html) @map("template_type")
  content              String                @db.LongText
  cssStyles            String?               @map("css_styles") @db.Text
  widthMm              Decimal               @default(85.60) @map("width_mm") @db.Decimal(7, 2)
  heightMm             Decimal               @default(54.00) @map("height_mm") @db.Decimal(7, 2)
  orientation          Orientation           @default(landscape)
  thumbnailUrl         String?               @map("thumbnail_url") @db.VarChar(500)
  description          String?               @db.Text
  isDefault            Boolean               @default(false) @map("is_default")
  isActive             Boolean               @default(true) @map("is_active")
  targetAudience       TemplateAudience      @default(ALL) @map("target_audience")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  certificates         Certificate[]
  hallTickets          HallTicket[]
  idCardBatches        IdCardBatch[]
  idCards              IdCard[]
  libraryCards         LibraryCard[]
  marksheets           Marksheet[]
  portfolios           Portfolio[]
  institution          Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  transferCertificates TransferCertificate[]
  visitingCards        VisitingCard[]

  @@index([institutionId])
  @@index([serviceType])
  @@index([isDefault])
  @@index([targetAudience])
  @@index([institutionId, serviceType])
  @@map("templates")
}

model IdCard {
  id            String       @id @default(uuid()) @db.Char(36)
  studentId     String       @map("student_id") @db.Char(36)
  institutionId String       @map("institution_id") @db.Char(36)
  templateId    String?      @map("template_id") @db.Char(36)
  cardNumber    String?      @unique @map("card_number") @db.VarChar(50)
  validFrom     DateTime?    @map("valid_from") @db.Date
  validUntil    DateTime?    @map("valid_until") @db.Date
  qrCodeData    String?      @map("qr_code_data") @db.Text
  barcodeData   String?      @map("barcode_data") @db.VarChar(100)
  cardFrontUrl  String?      @map("card_front_url") @db.VarChar(500)
  cardBackUrl   String?      @map("card_back_url") @db.VarChar(500)
  pdfUrl        String?      @map("pdf_url") @db.VarChar(500)
  status        IdCardStatus @default(draft)
  issuedAt      DateTime?    @map("issued_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  pdfObjectPath       String?      @map("pdf_object_path") @db.VarChar(500)
  cardFrontObjectPath String?      @map("card_front_object_path") @db.VarChar(500)
  cardBackObjectPath  String?      @map("card_back_object_path") @db.VarChar(500)
  institution         Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student             Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template            Template?    @relation(fields: [templateId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([templateId])
  @@map("id_cards")
}

model VisitingCard {
  id            String             @id @default(uuid()) @db.Char(36)
  studentId     String?            @map("student_id") @db.Char(36)
  userId        String?            @map("user_id") @db.Char(36)
  institutionId String             @map("institution_id") @db.Char(36)
  templateId    String?            @map("template_id") @db.Char(36)
  cardNumber    String             @unique @map("card_number") @db.VarChar(50)
  designation   String?            @db.VarChar(255)
  department    String?            @db.VarChar(255)
  email         String?            @db.VarChar(255)
  phone         String?            @db.VarChar(20)
  website       String?            @db.VarChar(255)
  linkedinUrl   String?            @map("linkedin_url") @db.VarChar(500)
  frontPdfUrl   String?            @map("front_pdf_url") @db.VarChar(500)
  backPdfUrl    String?            @map("back_pdf_url") @db.VarChar(500)
  thumbnailUrl  String?            @map("thumbnail_url") @db.VarChar(500)
  qrCodeData    String?            @map("qr_code_data") @db.Text
  status        VisitingCardStatus @default(draft)
  issuedAt      DateTime?          @map("issued_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       Student?           @relation(fields: [studentId], references: [id])
  template      Template?          @relation(fields: [templateId], references: [id])
  user          User?              @relation(fields: [userId], references: [id])

  @@index([institutionId])
  @@index([status])
  @@index([userId])
  @@index([studentId])
  @@index([templateId], map: "visiting_cards_template_id_fkey")
  @@map("visiting_cards")
}

model GroupPhoto {
  id                            String                     @id @default(uuid()) @db.Char(36)
  institutionId                 String                     @map("institution_id") @db.Char(36)
  sectionId                     String?                    @map("section_id") @db.Char(36)
  classId                       String?                    @map("class_id") @db.Char(36)
  name                          String                     @db.VarChar(255)
  eventName                     String?                    @map("event_name") @db.VarChar(255)
  eventDate                     DateTime?                  @map("event_date") @db.Date
  description                   String?                    @db.Text
  photoSessionName              String?                    @map("photo_session_name") @db.VarChar(255)
  photoDate                     DateTime?                  @map("photo_date") @db.Date
  location                      String?                    @db.VarChar(255)
  photographer                  String?                    @db.VarChar(255)
  photoUrl                      String                     @map("photo_url") @db.VarChar(500)
  thumbnailUrl                  String?                    @map("thumbnail_url") @db.VarChar(500)
  rawGroupPhotoUrl              String?                    @map("raw_group_photo_url") @db.VarChar(500)
  processedGroupPhotoUrl        String?                    @map("processed_group_photo_url") @db.VarChar(500)
  perceptualHash                String?                    @map("perceptual_hash") @db.VarChar(64)
  packageTier                   GroupPhotoPackage          @default(basic) @map("package_tier")
  status                        String                     @default("pending") @db.VarChar(20)
  processingStatus              GroupPhotoProcessingStatus @default(uploaded) @map("processing_status")
  faceDetectionCompleted        Boolean                    @default(false) @map("face_detection_completed")
  individualExtractionCompleted Boolean                    @default(false) @map("individual_extraction_completed")
  totalStudentsDetected         Int                        @default(0) @map("total_students_detected")
  rowCount                      Int                        @default(0) @map("row_count")
  teacherDetected               Boolean                    @default(false) @map("teacher_detected")
  metadata                      Json?
  createdAt                     DateTime                   @default(now()) @map("created_at")
  updatedAt                     DateTime                   @updatedAt @map("updated_at")
  extractions                   GroupPhotoExtraction[]
  class                         Class?                     @relation(fields: [classId], references: [id])
